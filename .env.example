# ─── Application ─────────────────────────────────────────────
APP_NAME=Sugar Booking API
APP_ENV=development          # development | production

# ─── Database ────────────────────────────────────────────────
# Production: postgresql+psycopg2://user:pass@host:5432/dbname
# Development: SQLite auto-configured if not set
DATABASE_URL=sqlite+aiosqlite:///./sugar_booking.db

# ─── JWT Authentication ─────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production
REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Password Policy ───────────────────────────────────────
# Min 8 chars, 1 uppercase, 1 lowercase, 1 digit, 1 special (!@#$%^&*()_+-=[]{}|;:,.<>?)
# Min 4 unique characters

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Redis (optional, for caching / rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0
