# ─── Application ─────────────────────────────────────────────
APP_NAME=Beauty Specialist API
APP_ENV=development          # development | production
LOG_LEVEL=                   # DEBUG | INFO | WARNING | ERROR (empty = INFO in prod, DEBUG locally)
# Absolute links in email/MAX/VK notifications
PUBLIC_BASE_URL=https://beauty-specialist.ru

# ─── Database ────────────────────────────────────────────────
# Production: postgresql+asyncpg://user:pass@host:5432/dbname
# Development: SQLite auto-configured if not set
DATABASE_URL=sqlite+aiosqlite:///./beauty_specialist.db

# ─── JWT Authentication ─────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production
REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
IMPERSONATION_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Password Policy ───────────────────────────────────────
# Min 8 chars, 1 uppercase, 1 lowercase, 1 digit, 1 special (!@#$%^&*()_+-=[]{}|;:,.<>?)
# Min 4 unique characters

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Redis (optional, for caching / rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0

# ─── SMS Settings ───────────────────────────────────────────
SMS_PROVIDER=fake              # fake | twilio | smsc
SMS_CODE_TTL_SECONDS=300       # 5 minutes
SMS_MAX_ATTEMPTS=3

# ─── Twilio (if SMS_PROVIDER=twilio) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── SMS.ru (if SMS_PROVIDER=smsc) ──────────────────────────
SMSC_LOGIN=
SMSC_PASSWORD=

# ─── MAX messenger bot (chat-bot auth; values live in backend/.env, never commit) ──
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_BOT_URL=
MAX_WEBHOOK_SECRET=
# Public webhook URL (prod only): switches on the self-healing subscription
# guard in the backend; empty = guard off (dev / long-poll mode)
MAX_WEBHOOK_URL=
# Optional custom CA bundle path (default: backend/certs/russian_trusted_ca.pem)
MAX_CA_BUNDLE=

# ─── Superuser (create_superuser.py; server .env / Secrets only, never commit) ──
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
# Optional contact phone for a newly created admin (never used for login).
SUPERUSER_PHONE=

# ─── Production sync (pull_production.py + setup_auto_sync.bat) ────────────
# Local use only: values live in backend/.env (gitignored), never commit them!
PROD_API=https://beauty-specialist.ru
PROD_EMAIL=
PROD_PASSWORD=
LOCAL_DEV_PASSWORD=DevPass123!
# LOCAL_DB=./online_booking.db

# ─── DaData ─────────────────────────────────────────────────
# Backend (канон: online-booking/backend/.env): оба ключа серверные, never commit.
DADATA_API_KEY=
DADATA_SECRET=
# Frontend (только публичный токен, секрет во фронте НЕ хранится — через backend-прокси /api/dadata):
# VITE_DADATA_TOKEN=

# ─── Telegram OAuth ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://beauty-specialist.ru/auth/callback

# ─── VK ID OAuth ────────────────────────────────────────────
# «ID приложения» из кабинета VK ID → VK_CLIENT_ID (строка, не приводить к числу).
# «Сервисный ключ доступа» → VK_SERVICE_TOKEN (НЕ «Защищённый ключ» VK API).
# Redirect URI регистрируется в настройках приложения VK:
# https://beauty-specialist.ru/auth/vk/callback
# Ровно эти же имена читает app/config.py (VK_APP_ID/VK_SECRET_KEY не используются).
VK_CLIENT_ID=
VK_SERVICE_TOKEN=
VK_REDIRECT_URI=https://beauty-specialist.ru/auth/vk/callback
# Необязательные scope через пробел; пусто = по умолчанию
VK_SCOPE=
# Уведомления в VK: токен СООБЩЕСТВА (не VK_SERVICE_TOKEN приложения VK ID)
# с правом messages. Пусто = канал VK недоступен. Пользователь должен
# разрешить сообщения от сообщества.
VK_NOTIFY_TOKEN=
VK_API_VERSION=5.199

# ─── Yandex OAuth ───────────────────────────────────────────
# Яндекс OAuth (Authorization Code, серверный обмен по «Паролю приложения»).
# «ID приложения» → YANDEX_CLIENT_ID; «Пароль приложения» → YANDEX_CLIENT_SECRET.
# Redirect URI должен быть добавлен в настройках приложения Яндекса
# (Платформы приложений → Веб-сервисы → Redirect URI).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Зарегистрированный redirect (страница-приёмник фронтенда /auth/yandex/callback):
YANDEX_REDIRECT_URI=https://beauty-specialist.ru/auth/yandex/callback
# Необязательные scope через пробел; пусто = по умолчанию (login:info + login:email)
YANDEX_SCOPE=
# Страница-приёмник токена для официального виджета «Мгновенная авторизация»
# (sdk-suggest.js; страница frontend/public/suggest-token.html). Её URL должен
# быть добавлен в Redirect URI приложения Яндекса; пусто = виджет выключен,
# остаётся обычная кнопка-редирект.
YANDEX_SUGGEST_REDIRECT_URI=

# ─── Mail.ru OAuth ──────────────────────────────────────────
MAILRU_APP_ID=
MAILRU_SECRET_KEY=

# ─── Sentry (error tracking, optional) ──
# DSN from https://sentry.io/. Empty = disabled.
# Example: https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=

# ─── Outgoing email / SMTP (1.79.0: коды входа, сброс пароля) ──
# Обычный ящик Яндекса (не 360): smtp.yandex.ru:465 (SSL) + ПАРОЛЬ ПРИЛОЖЕНИЯ
# («Почтовые программы» в Яндекс ID → пароли приложений), не пароль аккаунта.
# Пусто = отправка выключена: письма только пишутся в лог (локальная разработка).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Имя отправителя в письмах; адрес = SMTP_USER, если SMTP_FROM_EMAIL пуст
SMTP_FROM_NAME=Электронная запись
SMTP_FROM_EMAIL=
