# ─── Application ─────────────────────────────────────────────
APP_NAME=Sugar Booking API
APP_ENV=development          # development | production

# ─── Database ────────────────────────────────────────────────
# Production: postgresql+asyncpg://user:pass@host:5432/dbname
# Development: SQLite auto-configured if not set
DATABASE_URL=sqlite+aiosqlite:///./sugar_booking.db

# ─── JWT Authentication ─────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production
REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Password Policy ───────────────────────────────────────
# Min 8 chars, 1 uppercase, 1 lowercase, 1 digit, 1 special (!@#$%^&*()_+-=[]{}|;:,.<>?)
# Min 4 unique characters

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Redis (optional, for caching / rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0

# ─── SMS Settings ───────────────────────────────────────────
SMS_PROVIDER=fake              # fake | twilio | smsc
SMS_CODE_TTL_SECONDS=300       # 5 minutes
SMS_MAX_ATTEMPTS=3

# ─── Twilio (if SMS_PROVIDER=twilio) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── SMS.ru (if SMS_PROVIDER=smsc) ──────────────────────────
SMSC_LOGIN=
SMSC_PASSWORD=

# ─── DaData ─────────────────────────────────────────────────
DADATA_API_KEY=
DADATA_SECRET=

# ─── Telegram OAuth ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://beauty-specialist.ru/auth/callback

# ─── VK OAuth ───────────────────────────────────────────────
VK_APP_ID=
VK_SECRET_KEY=

# ─── Yandex OAuth ───────────────────────────────────────────
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── Mail.ru OAuth ──────────────────────────────────────────
MAILRU_APP_ID=
MAILRU_SECRET_KEY=
